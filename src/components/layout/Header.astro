---
import ThemeToggle from "../ThemeToggle.astro";
import Search from "../Search.astro";

const path = new URL(Astro.request.url).pathname;
const links = [
    { title: "Writing", path: "/blog/" },
    { title: "Links", path: "/links/" },
    { title: "Uses", path: "/uses/" },
];
---

<header
    class="site-shell rule flex flex-wrap items-center justify-between gap-x-6 gap-y-4 border-b py-6 sm:py-8"
>
    <a
        href="/"
        class="text-[17px] font-semibold tracking-[-0.04em]"
        aria-label="Vic Vijayakumar, home">Vic Vijayakumar<span aria-hidden="true">.</span></a
    >
    <div class="flex items-center gap-3 sm:gap-6">
        <nav
            aria-label="Main menu"
            class="flex items-center gap-4 text-[14px] sm:gap-7 sm:text-[15px]"
        >
            {
                links.map((link) => (
                    <a
                        href={link.path}
                        aria-current={path.startsWith(link.path) ? "page" : undefined}
                        class="hover:underline aria-[current=page]:underline"
                        rel="prefetch"
                    >
                        {link.title}
                    </a>
                ))
            }
        </nav>
        <div class="rule flex items-center border-l pl-2 sm:pl-4">
            <Search />
            <ThemeToggle />
        </div>
    </div>
</header>
