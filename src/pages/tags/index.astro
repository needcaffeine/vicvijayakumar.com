---
import PageLayout from "@/layouts/Base";
import { getUniqueTagsWithCount } from "@/utils";
import { getCollection } from "astro:content";

const allPosts = await getCollection("post");
const allTags = getUniqueTagsWithCount(allPosts);

const meta = {
    title: "All Tags",
    description: "A list of all the topics I've written about in my posts",
};
---

<PageLayout meta={meta}>
    <div class="page-width">
        <p class="eyebrow mb-6">Archive</p>
        <h1 class="page-title mb-8">Topics</h1>
        {
            allTags.length ? (
                <ul class="editorial-list">
                    {allTags.map(([tag, count]) => (
                        <li class="flex items-baseline justify-between gap-4">
                            <a class="text-link text-xl" href={`/tags/${tag}/`} rel="prefetch">
                                {tag}
                            </a>
                            <span class="muted text-sm">{count} {count === 1 ? "post" : "posts"}</span>
                        </li>
                    ))}
                </ul>
            ) : (
                <div class="editorial-list">
                    <p class="muted border-b rule py-6">There aren’t any topics yet.</p>
                    <a class="text-link mt-8 inline-block" href="/blog/">Browse all writing →</a>
                </div>
            )
        }
    </div>
</PageLayout>
