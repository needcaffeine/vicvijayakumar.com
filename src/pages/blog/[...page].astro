---
import Pagination from "@/components/Paginator";
import PostPreview from "@/components/blog/PostPreview";
import PageLayout from "@/layouts/Base";
import { getUniqueTags, sortMDByDate } from "@/utils";
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

export const getStaticPaths = (async ({ paginate }) => {
    const allPosts = await getCollection("post");
    const allPostsByDate = sortMDByDate(allPosts);
    const uniqueTags = getUniqueTags(allPosts);
    return paginate(allPostsByDate, { props: { uniqueTags }, pageSize: 100 });
}) satisfies GetStaticPaths;

interface Props {
    page: Page<CollectionEntry<"post">>;
    uniqueTags: string[];
}

const { page, uniqueTags } = Astro.props;

const meta = {
    title: "Writing",
    description: "Notes on software, projects, and the things that interest me.",
};

const paginationProps = {
    ...(page.url.prev && {
        prevUrl: {
            url: page.url.prev,
            text: `← Previous Posts`,
        },
    }),
    ...(page.url.next && {
        nextUrl: {
            url: page.url.next,
            text: `Next Posts →`,
        },
    }),
};
---

<PageLayout meta={meta}>
    <div class="page-width">
        <p class="eyebrow mb-6">Archive</p>
        <h1 class="page-title mb-8">Writing.</h1>
        <p class="muted mb-16 max-w-[620px] text-xl">
            Things I’ve learned, built, and thought about. Some are polished; some are just useful
            notes.
        </p>
    </div>
    <div class="page-width">
        <section aria-label="Blog post list">
            <ul class="editorial-list text-start">
                {
                    page.data.map((p) => (
                        <li>
                            <PostPreview post={p} as="h2" withDesc />
                        </li>
                    ))
                }
            </ul>
            <Pagination {...paginationProps} />
        </section>
        {
            !!uniqueTags.length && (
                <aside class="mt-16">
                    <h2 class="eyebrow mb-5">Topics</h2>
                    <ul class="flex flex-wrap gap-x-3 gap-y-2 text-[14px]">
                        {uniqueTags.map((tag) => (
                            <li>
                                <a
                                    class="text-link"
                                    href={`/tags/${tag}/`}
                                    aria-label={`View all posts with the tag: ${tag}`}
                                >
                                    {tag}
                                </a>
                            </li>
                        ))}
                    </ul>
                    <span class="mt-6 block text-[14px]">
                        <a class="text-link" href="/tags/" aria-label="View all blog categories">
                            All topics →
                        </a>
                    </span>
                </aside>
            )
        }
    </div>
</PageLayout>
