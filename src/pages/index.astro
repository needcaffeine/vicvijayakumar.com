---
import PageLayout from "@/layouts/Base";
import { sortMDByDate } from "@/utils";
import { getCollection } from "astro:content";

const posts = sortMDByDate(await getCollection("post"));
const favorites = posts.filter((post) => post.data.favorite).slice(0, 4);
const projects = [
    {
        name: "Everyoak",
        description: "Less paperwork for preschools.",
        href: "https://www.everyoak.com",
    },
    {
        name: "Onetime Fax",
        description: "Send a fax without owning a fax machine.",
        href: "https://www.onetimefax.com",
    },
    {
        name: "Engineering Advice",
        description: "Conversations about leading software teams.",
        href: "https://engineeringadvice.dev",
    },
];
---

<PageLayout meta={{ title: "Home" }}>
    <div class="home-content">
        <section aria-labelledby="intro-title" class="home-intro">
            <h1 id="intro-title" class="home-title">Vic Vijayakumar</h1>
            <p class="home-lead">
                I’m a software engineer in Raleigh, North Carolina. I build useful things, start a
                lot of projects, and write down what I learn.
            </p>
            <p class="home-personal">
                Outside of work: running, cooking, reading, playing violin, being a dad, and tending
                to our backyard chickens.
            </p>
            <div class="home-links">
                <a
                    href="https://github.com/needcaffeine"
                    rel="me noopener noreferrer"
                    target="_blank">GitHub ↗</a
                >
                <a
                    href="https://www.linkedin.com/in/vicvijayakumar/"
                    rel="me noopener noreferrer"
                    target="_blank">LinkedIn ↗</a
                >
                <a href="https://vic.substack.com" rel="noopener noreferrer" target="_blank"
                    >Newsletter ↗</a
                >
            </div>
        </section>

        <section aria-labelledby="work-title" class="home-section">
            <div class="home-section-heading">
                <h2 id="work-title">A few things I’ve made</h2>
                <a href="/links/">More links →</a>
            </div>
            <ul class="home-projects">
                {
                    projects.map((project) => (
                        <li>
                            <a href={project.href} rel="noopener noreferrer" target="_blank">
                                {project.name} ↗
                            </a>
                            <span>{project.description}</span>
                        </li>
                    ))
                }
            </ul>
        </section>

        <section aria-labelledby="writing-title" class="home-section">
            <div class="home-section-heading">
                <h2 id="writing-title">Some writing</h2>
                <a href="/blog/">All posts →</a>
            </div>
            <ul class="home-writing">
                {
                    favorites.map((post) => (
                        <li>
                            <time datetime={post.data.publishDate.toISOString()}>
                                {post.data.publishDate.getFullYear()}
                            </time>
                            <h3>
                                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                            </h3>
                        </li>
                    ))
                }
            </ul>
        </section>
    </div>
</PageLayout>
