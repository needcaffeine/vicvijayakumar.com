---
import type { CollectionEntry } from "astro:content";

import BaseLayout from "./Base.astro";
import BlogHero from "@/components/blog/Hero";

interface Props {
    post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const {
    data: { title, description, ogImage, publishDate, updatedDate },
    slug,
} = post;
const socialImage = ogImage ?? `/og-image/${slug}.png`;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();
---

<BaseLayout meta={{ title, description, articleDate, ogImage: socialImage }}>
    <div class="mx-auto max-w-[780px]">
        <article class="break-words" data-pagefind-body>
            <div id="blog-hero"><BlogHero content={post} /></div>
            <div
                class="prose prose-lg prose-cactus mt-16 max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-accent-2 prose-p:leading-[1.75]"
            >
                <slot />
            </div>
        </article>
    </div>
</BaseLayout>
